# .env.example

# [General]
# Set the environment mode. Use 'production' for live deployments.
APP_ENV=development

# [Security]
# IMPORTANT: Replace this with a strong, randomly generated key in your .env or .env.prod file.
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here

# [Database]
# For production, it is highly recommended to use PostgreSQL.
# Example for PostgreSQL: postgresql+psycopg2://user:password@host:port/dbname
# For local development, SQLite is used by default.
SQLALCHEMY_DATABASE_URL="sqlite:///./burn_after_reading.db"

# [CORS]
# A comma-separated list of origins that are allowed to make requests.
# For production, this should be your domain: e.g., https://your_domain.com
# For local development, it's typically your frontend's address.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# [Application Settings]
# Maximum allowed file size for uploads, in bytes.
# Example: 5 * 1024 * 1024 = 5MB
MAX_FILE_SIZE_BYTES=5242880

# This should match the client_max_body_size in your Nginx configuration.
CLIENT_MAX_BODY_SIZE=5M
